# Environment variable stubs for mcp-server-kit.
# Fill in real values locally; never commit this file with real secrets.

# Shared (all servers, via AuthenticatedMCPServer)
export MCP_DB_PATH=./api_keys.db         # optional, default ./api_keys.db

# Contact server
export CONTACTS_DB_PATH=./contacts.db    # optional, default ./contacts.db

# Weather server
export OPENWEATHER_API_KEY=              # required — free OpenWeatherMap API key

# Messaging server — Twilio SMS
export TWILIO_ACCOUNT_SID=               # required — starts with "AC"
# Set exactly one of the two auth vars below (mutually exclusive):
export TWILIO_AUTH_TOKEN=                # Twilio auth token
export TWILIO_BASIC_AUTH=                # pre-encoded "Authorization: Basic <value>" credential (no "Basic " prefix)
export TWILIO_MESSAGING_SERVICE_SID=     # required — starts with "MG"

# Messaging server — SendGrid email
export SENDGRID_API_KEY=                 # required — starts with "SG."
export SENDGRID_FROM_EMAIL=demo@kore.com # required — verified sender address
export SENDGRID_FROM_NAME=               # optional — display name for the sender
